rules_version = '2';

// 로그인한 본인만 자기 데이터(users/{uid}/…)를 읽고 쓸 수 있다.
// 쓰는 문서는 { k, v, t } 모양이고 v는 약 900KB 이하의 문자열이어야 한다.
service cloud.firestore {
  match /databases/{database}/documents {
    match /users/{uid}/kv/{key} {
      allow read: if request.auth != null && request.auth.uid == uid;
      allow write: if request.auth != null && request.auth.uid == uid
        && request.resource.data.keys().hasOnly(['k', 'v', 't'])
        && request.resource.data.v is string
        && request.resource.data.v.size() < 900000
        && request.resource.data.t is number;
    }
  }
}
